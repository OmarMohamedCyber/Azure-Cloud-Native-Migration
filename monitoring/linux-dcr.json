{
  "properties": {
    "dataSources": {
      "performanceCounters": [
        {
          "name": "linux-performance",
          "streams": [
            "Microsoft-Perf"
          ],
          "samplingFrequencyInSeconds": 60,
          "counterSpecifiers": [
            "\\Processor(*)\\% Processor Time",
            "\\Memory\\Available Bytes",
            "\\Logical Disk(*)\\% Free Space"
          ]
        }
      ],
      "syslog": [
        {
          "name": "linux-syslog",
          "streams": [
            "Microsoft-Syslog"
          ],
          "facilityNames": [
            "auth",
            "authpriv",
            "cron",
            "daemon",
            "kern",
            "syslog",
            "user"
          ],
          "logLevels": [
            "Warning",
            "Error",
            "Critical",
            "Alert",
            "Emergency"
          ]
        }
      ]
    },
    "destinations": {
      "logAnalytics": [
        {
          "name": "central-workspace",
          "workspaceResourceId": "/subscriptions/1b30434e-fa32-4767-a905-8eb093430056/resourceGroups/rg-cloud-migration-lab/providers/Microsoft.OperationalInsights/workspaces/law-cloud-monitoring"
        }
      ]
    },
    "dataFlows": [
      {
        "streams": [
          "Microsoft-Perf",
          "Microsoft-Syslog"
        ],
        "destinations": [
          "central-workspace"
        ]
      }
    ]
  }
}